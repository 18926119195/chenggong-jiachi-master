# DeepSeek API 配置

# API 密钥（必填）
LLM_API_KEY=sk-df0ae9e78ee14baaa4c1604c447ee835

# 模型配置
# DeepSeek-V4.1-Flash（官方统一名称：deepseek-flash）
# - 支持 1M tokens 输入上下文，384K tokens 最大输出
# - Thinking 模式默认开启，已硬编码关闭（reasoning_effort: none）
# - 默认 max_tokens: 32768（安全阈值，避免高额费用）
# - 并发限制：2500 requests
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com

# 可选：并发数控制
# LLM_CONCURRENCY=5
# BATCH_SIZE=8
